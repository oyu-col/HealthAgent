# Copy to HealthAgent/.env. Always select the mode explicitly.
# fake runs the real agent graph with a local demonstration model, without an LLM API call.
HEALTH_AGENT_MODEL_MODE=fake

# For provider mode, set all three fields. No silent fallback to fake.
# HEALTH_AGENT_MODEL_MODE=provider
# HEALTH_AGENT_MODEL_NAME=your-model-name
# HEALTH_AGENT_MODEL_BASE_URL=https://api.openai.com/v1
# HEALTH_AGENT_MODEL_API_KEY=replace-with-your-key

HEALTH_AGENT_REQUEST_TIMEOUT_SECONDS=60
HEALTH_AGENT_MODEL_TIMEOUT_SECONDS=20
HEALTH_AGENT_MODEL_MAX_RETRIES=1
HEALTH_AGENT_MAX_STEPS=12
HEALTH_AGENT_MAX_INPUT_CHARS=8000
HEALTH_AGENT_MAX_TOOL_CALLS=12
HEALTH_AGENT_LOCAL_USER_ID=local-user
HEALTH_AGENT_TIMEZONE=Asia/Shanghai

# Local mode is only for a loopback, single-user server. Shared deployments use token mode.
HEALTH_AGENT_AUTH_MODE=local
# HEALTH_AGENT_AUTH_MODE=token
# Use distinct, random tokens of at least 16 characters. Keys are server-side user IDs.
# HEALTH_AGENT_API_TOKENS={"alice":"replace-with-random-alice-token","bob":"replace-with-random-bob-token"}

# Defaults to HealthAgent/data. Keep health.db and checkpoints.db private; use one worker.
# HEALTH_AGENT_DATA_DIR=D:/AgentFiles/HealthAgent/data

# Offline lexical n-gram vector baseline; no model download or embedding API request.
HEALTH_AGENT_EMBEDDING_MODE=local_hash
HEALTH_AGENT_EMBEDDING_DIMENSIONS=1024
# Optional real semantic embeddings, using the explicit MODEL_BASE_URL and MODEL_API_KEY above.
# HEALTH_AGENT_EMBEDDING_MODE=provider
# HEALTH_AGENT_EMBEDDING_MODEL=text-embedding-3-small
# Changing embedding configuration creates a new index version; re-import original documents.

# Explicit preferences only; measurements and medical facts stay in the health database.
HEALTH_AGENT_MEMORY_ENABLED=true

# Phase 7/8: bounded, read-only specialists and shared execution budgets.
HEALTH_AGENT_SUBAGENTS_ENABLED=true
HEALTH_AGENT_MAX_DELEGATIONS=3
HEALTH_AGENT_SUBAGENT_MAX_CONCURRENCY=2
HEALTH_AGENT_SUBAGENT_TIMEOUT_SECONDS=20
HEALTH_AGENT_SUBAGENT_MAX_STEPS=8
HEALTH_AGENT_TOOL_TIMEOUT_SECONDS=10
HEALTH_AGENT_TOOL_MAX_RETRIES=2
HEALTH_AGENT_TOOL_RETRY_INITIAL_DELAY=0.1
# Phase 10 trace metadata is local, redacted and bounded; no external tracing enabled.
